module

import IntegralClosure
import Mathlib.Data.ZMod.Basic
import Mathlib.Tactic.NormNum

/-!
# Jacobson containment for reduction of residue class rings

Reduction from `ZMod 8` to `ZMod 4` sends the nonzero proper ideal generated by
`2`, contained in the source Jacobson radical, to a nonzero ideal contained in
the target Jacobson radical. This homomorphism is surjective, so this example
also lies in the scope of Mathlib's surjective Jacobson formula.
Reduction from `ZMod 8` to the zero ring `ZMod 1` gives a zero-ring boundary.

The residue-class homomorphisms and their surjectivity use Mathlib's `ZMod` API;
integrality uses `RingHom.isIntegral_of_surjective`.
-/

noncomputable section

private def reduction : ZMod 8 →+* ZMod 4 :=
  ZMod.castHom (by decide : 4 ∣ 8) (ZMod 4)

private theorem reduction_isIntegral : reduction.IsIntegral := by
  exact RingHom.isIntegral_of_surjective reduction
    (ZMod.castHom_surjective (by decide : 4 ∣ 8))

private def evenIdeal : Ideal (ZMod 8) :=
  Ideal.span ({2} : Set (ZMod 8))

private theorem two_mem_evenIdeal : (2 : ZMod 8) ∈ evenIdeal := by
  exact Ideal.subset_span (by simp)

private theorem evenIdeal_ne_bot : evenIdeal ≠ ⊥ := by
  intro h
  have htwo := two_mem_evenIdeal
  rw [h, Ideal.mem_bot] at htwo
  exact (by decide : (2 : ZMod 8) ≠ 0) htwo

private theorem evenIdeal_ne_top : evenIdeal ≠ ⊤ := by
  intro h
  have hu : IsUnit (2 : ZMod 8) := Ideal.span_singleton_eq_top.mp h
  have hc := (ZMod.isUnit_iff_coprime 2 8).mp hu
  exact (by decide : ¬ Nat.Coprime 2 8) hc

private theorem evenIdeal_le_jacobson_bot :
    evenIdeal ≤ (⊥ : Ideal (ZMod 8)).jacobson := by
  apply Ideal.span_le.mpr
  intro x hx
  have hx' : x = (2 : ZMod 8) := Set.mem_singleton_iff.mp hx
  subst x
  apply Ideal.radical_le_jacobson
  exact Ideal.mem_radical_iff.mpr
    ⟨3, Ideal.mem_bot.mpr (by decide : (2 : ZMod 8) ^ 3 = 0)⟩

private theorem reduction_comap_jacobson_bot :
    (⊥ : Ideal (ZMod 4)).jacobson.comap reduction =
      ((⊥ : Ideal (ZMod 4)).comap reduction).jacobson := by
  exact Ideal.comap_jacobson_of_isIntegral reduction reduction_isIntegral ⊥

private theorem reduction_map_jacobson_evenIdeal :
    evenIdeal.jacobson.map reduction ≤ (evenIdeal.map reduction).jacobson := by
  exact Ideal.map_jacobson_le_of_isIntegral reduction reduction_isIntegral evenIdeal

private theorem reduction_map_evenIdeal_le_jacobson_bot :
    evenIdeal.map reduction ≤ (⊥ : Ideal (ZMod 4)).jacobson := by
  exact Ideal.map_le_jacobson_bot_of_isIntegral reduction reduction_isIntegral
    evenIdeal evenIdeal_le_jacobson_bot

private theorem reduction_two_ne_zero : reduction (2 : ZMod 8) ≠ 0 := by
  rw [map_ofNat]
  decide

private theorem reduction_map_evenIdeal_ne_bot : evenIdeal.map reduction ≠ ⊥ := by
  intro h
  have hm := Ideal.mem_map_of_mem reduction two_mem_evenIdeal
  rw [h, Ideal.mem_bot] at hm
  exact reduction_two_ne_zero hm

private def zeroReduction : ZMod 8 →+* ZMod 1 :=
  ZMod.castHom (by decide : 1 ∣ 8) (ZMod 1)

private theorem zeroReduction_isIntegral : zeroReduction.IsIntegral := by
  exact RingHom.isIntegral_of_surjective zeroReduction
    (ZMod.castHom_surjective (by decide : 1 ∣ 8))

private theorem zeroReduction_jacobson :
    (∀ J : Ideal (ZMod 1), J = ⊥) ∧
      (⊥ : Ideal (ZMod 1)).jacobson.comap zeroReduction =
        ((⊥ : Ideal (ZMod 1)).comap zeroReduction).jacobson := by
  exact ⟨fun _ => Subsingleton.elim _ _,
    Ideal.comap_jacobson_of_isIntegral zeroReduction zeroReduction_isIntegral ⊥⟩
